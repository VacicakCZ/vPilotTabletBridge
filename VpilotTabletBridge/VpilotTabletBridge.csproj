<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VpilotTabletBridge</AssemblyName>
    <RootNamespace>VpilotTabletBridge</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      The release number, bumped with every GitHub release. FlightOps Hub,
      which ships a copy of this DLL, compares the installed plugin's file
      version with the one it carries to offer an update - every build up to
      v1.0.3 said 1.0.0.0.
    -->
    <Version>1.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference copy of vPilot's own plugin API assembly.
      It ships in the vPilot install folder (%LocalAppData%\vPilot); a copy
      is kept in ..\lib so the project builds without depending on any one
      machine's install path. It is NOT copied to the output folder
      (Private=false) because vPilot.exe already has this exact assembly
      loaded when it loads our plugin, so the host's copy is used at runtime.
    -->
    <Reference Include="RossCarlson.Vatsim.Vpilot.Plugins">
      <HintPath>..\lib\RossCarlson.Vatsim.Vpilot.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Part of .NET Framework itself (JavaScriptSerializer, for reading the CTAF lookup's JSON reply) - not an extra dependency. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="www\index.html">
      <LogicalName>VpilotTabletBridge.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="www\qr.html">
      <LogicalName>VpilotTabletBridge.qr.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
